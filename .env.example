# Copy this file to .env.local and fill in your own values.
# Do not commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key. Safe in the browser, protected by row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key. Server only. Never import it in client code.
SUPABASE_SERVICE_ROLE_KEY=
# CLI token for `supabase` commands. Not needed at runtime.
SUPABASE_ACCESS_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# It changes every time you restart `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# --- Resend ---
RESEND_API_KEY=
# Sender address for transactional email.
FROM_EMAIL=noreply@example.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
